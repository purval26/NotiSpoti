<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_pressed="true">
        <shape android:shape="rectangle">
            <gradient
                android:angle="0"
                android:startColor="#19B550"
                android:endColor="#119A40"
                android:type="linear" />
            <corners android:radius="32dp" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <gradient
                android:angle="0"
                android:startColor="#1ED760"
                android:endColor="#15BD4F"
                android:type="linear" />
            <corners android:radius="32dp" />
        </shape>
    </item>
</selector>
