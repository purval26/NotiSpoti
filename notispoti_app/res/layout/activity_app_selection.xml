<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#121212"
    android:padding="16dp">

    <!-- Top Navigation Bar -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:layout_marginBottom="12dp">

        <Button
            android:id="@+id/btnBack"
            android:layout_width="wrap_content"
            android:layout_height="38dp"
            android:text="← Back"
            android:textColor="#FFFFFF"
            android:textSize="12sp"
            android:background="@drawable/bg_m3_pill_secondary"
            android:paddingLeft="14dp"
            android:paddingRight="14dp"
            android:layout_marginRight="10dp" />

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Source Apps"
            android:textColor="#FFFFFF"
            android:textSize="18sp"
            android:textStyle="bold" />

        <Button
            android:id="@+id/btnSave"
            android:layout_width="wrap_content"
            android:layout_height="38dp"
            android:text="Save"
            android:textColor="#FFFFFF"
            android:textSize="12sp"
            android:textStyle="bold"
            android:background="@drawable/bg_m3_pill_button"
            android:paddingLeft="18dp"
            android:paddingRight="18dp" />
    </LinearLayout>

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Only notifications from selected apps will be synced to Spotify."
        android:textColor="#8E8E93"
        android:textSize="13sp"
        android:layout_marginBottom="12dp" />

    <!-- Search Input -->
    <EditText
        android:id="@+id/inputSearchApp"
        android:layout_width="match_parent"
        android:layout_height="46dp"
        android:background="@drawable/bg_m3_input"
        android:paddingLeft="14dp"
        android:paddingRight="14dp"
        android:hint="Search installed apps..."
        android:textColor="#FFFFFF"
        android:textColorHint="#66726B"
        android:textSize="13sp"
        android:singleLine="true"
        android:layout_marginBottom="10dp" />

    <!-- Action Toolbar (Defaults / Clear / Counter) -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:layout_marginBottom="10dp">

        <Button
            android:id="@+id/btnResetDefaults"
            android:layout_width="wrap_content"
            android:layout_height="34dp"
            android:text="Reset Defaults"
            android:textColor="#A3E7B2"
            android:textSize="11sp"
            android:background="@drawable/bg_m3_pill_secondary"
            android:paddingLeft="12dp"
            android:paddingRight="12dp"
            android:layout_marginRight="8dp" />

        <Button
            android:id="@+id/btnClearAll"
            android:layout_width="wrap_content"
            android:layout_height="34dp"
            android:text="Clear All"
            android:textColor="#FF8A80"
            android:textSize="11sp"
            android:background="@drawable/bg_m3_pill_secondary"
            android:paddingLeft="12dp"
            android:paddingRight="12dp"
            android:layout_marginRight="8dp" />

        <TextView
            android:id="@+id/selectedCountText"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="right"
            android:text="Selected: 0"
            android:textColor="#1DB954"
            android:textSize="12sp"
            android:textStyle="bold" />
    </LinearLayout>

    <!-- Loading Indicator -->
    <ProgressBar
        android:id="@+id/loadingProgress"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center_horizontal"
        android:visibility="gone"
        android:layout_margin="16dp" />

    <!-- App List -->
    <ListView
        android:id="@+id/appListView"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:divider="@null"
        android:dividerHeight="0dp"
        android:choiceMode="none" />

</LinearLayout>
