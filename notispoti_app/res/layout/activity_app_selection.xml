<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#121212"
    android:padding="12dp">

    <!-- Top Navigation Bar -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:layout_marginBottom="8dp">

        <Button
            android:id="@+id/btnBack"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="← Back"
            android:textSize="12sp"
            android:layout_marginRight="8dp" />

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Select Source Apps"
            android:textColor="#1DB954"
            android:textSize="18sp"
            android:textStyle="bold" />

        <Button
            android:id="@+id/btnSave"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Save"
            android:textSize="12sp" />
    </LinearLayout>

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Only notifications from selected apps will be synced to Spotify."
        android:textColor="#A0A0A0"
        android:textSize="12sp"
        android:layout_marginBottom="10dp" />

    <!-- Search Input -->
    <EditText
        android:id="@+id/inputSearchApp"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="#202020"
        android:padding="10dp"
        android:hint="Search installed apps..."
        android:textColor="#FFFFFF"
        android:textColorHint="#777777"
        android:textSize="13sp"
        android:singleLine="true"
        android:layout_marginBottom="8dp" />

    <!-- Action Toolbar (Defaults / Clear / Counter) -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:layout_marginBottom="8dp">

        <Button
            android:id="@+id/btnResetDefaults"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Reset Defaults"
            android:textSize="11sp"
            android:layout_marginRight="6dp" />

        <Button
            android:id="@+id/btnClearAll"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Clear All"
            android:textSize="11sp"
            android:layout_marginRight="6dp" />

        <TextView
            android:id="@+id/selectedCountText"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="right"
            android:text="Selected: 0"
            android:textColor="#1DB954"
            android:textSize="12sp"
            android:textStyle="bold" />
    </LinearLayout>

    <!-- Loading Indicator -->
    <ProgressBar
        android:id="@+id/loadingProgress"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center_horizontal"
        android:visibility="gone"
        android:layout_margin="16dp" />

    <!-- App List -->
    <ListView
        android:id="@+id/appListView"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:divider="#262626"
        android:dividerHeight="1dp"
        android:choiceMode="none" />

</LinearLayout>
