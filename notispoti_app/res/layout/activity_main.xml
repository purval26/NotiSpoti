<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#0A0F0C">

    <!-- Main Scrollable Content Area -->
    <ScrollView
        android:id="@+id/mainScrollView"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true"
        android:scrollbars="none">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp">

            <!-- A. HEADER BAR -->
            <!-- [NotiSpoti logo] NotiSpoti               [Settings] -->
            <!-- Subtitle: "Music from anywhere to Instagram Notes"  -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginBottom="16dp">

                <ImageView
                    android:layout_width="42dp"
                    android:layout_height="42dp"
                    android:src="@drawable/ic_launcher"
                    android:layout_marginRight="12dp" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="NotiSpoti"
                        android:textColor="#FFFFFF"
                        android:textSize="22sp"
                        android:textStyle="bold" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Music from anywhere to Instagram Notes"
                        android:textColor="#8E8E93"
                        android:textSize="12sp"
                        android:layout_marginTop="1dp" />
                </LinearLayout>

                <ImageButton
                    android:id="@+id/btnTopSettings"
                    android:layout_width="40dp"
                    android:layout_height="40dp"
                    android:src="@drawable/ic_settings"
                    android:background="@drawable/bg_circle_button"
                    android:scaleType="centerInside"
                    android:contentDescription="Settings" />
            </LinearLayout>

            <!-- ================================================= -->
            <!-- HOME SCREEN MAIN CONTAINER                        -->
            <!-- ================================================= -->
            <LinearLayout
                android:id="@+id/viewHomeTab"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <!-- B. MAIN SYNC CARD -->
                <!-- ● ON                                              -->
                <!-- Your music, everywhere.                           -->
                <!-- "Automatically detects what you're listening to   -->
                <!-- and syncs it to Spotify in the background."       -->
                <!-- Large ON/OFF Switch                               -->
                <LinearLayout
                    android:id="@+id/heroCard"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:background="@drawable/bg_hero_card"
                    android:padding="18dp"
                    android:layout_marginBottom="14dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical">

                        <TextView
                            android:id="@+id/heroSyncBadge"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="● ON"
                            android:textColor="#1ED760"
                            android:textSize="12sp"
                            android:textStyle="bold"
                            android:background="@drawable/bg_m3_chip_active"
                            android:paddingLeft="10dp"
                            android:paddingRight="10dp"
                            android:paddingTop="3dp"
                            android:paddingBottom="3dp" />

                        <TextView
                            android:id="@+id/heroSyncSubStatus"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="Syncing automatically"
                            android:textColor="#1ED760"
                            android:textSize="12sp"
                            android:textStyle="bold"
                            android:layout_marginLeft="10dp" />

                        <Switch
                            android:id="@+id/masterSyncSwitch"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content" />
                    </LinearLayout>

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Your music, everywhere."
                        android:textColor="#FFFFFF"
                        android:textSize="20sp"
                        android:textStyle="bold"
                        android:layout_marginTop="12dp" />

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Automatically detects what you're listening to and syncs it to Spotify in the background."
                        android:textColor="#A0B0A6"
                        android:textSize="13sp"
                        android:lineSpacingExtra="3dp"
                        android:layout_marginTop="6dp" />
                </LinearLayout>

                <!-- C. NOW PLAYING CARD -->
                <LinearLayout
                    android:id="@+id/nowPlayingCard"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:background="@drawable/bg_m3_card"
                    android:padding="16dp"
                    android:layout_marginBottom="14dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical"
                        android:layout_marginBottom="12dp">

                        <ImageView
                            android:layout_width="16dp"
                            android:layout_height="16dp"
                            android:src="@drawable/ic_waves"
                            android:layout_marginRight="6dp" />

                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="NOW PLAYING"
                            android:textColor="#1ED760"
                            android:textSize="12sp"
                            android:textStyle="bold" />

                        <LinearLayout
                            android:id="@+id/syncedSpotifyBadge"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal"
                            android:gravity="center_vertical"
                            android:background="@drawable/bg_m3_chip_active"
                            android:paddingLeft="8dp"
                            android:paddingRight="8dp"
                            android:paddingTop="3dp"
                            android:paddingBottom="3dp">

                            <ImageView
                                android:layout_width="14dp"
                                android:layout_height="14dp"
                                android:src="@drawable/ic_spotify_small"
                                android:layout_marginRight="4dp" />

                            <TextView
                                android:id="@+id/syncedBadgeText"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Synced to Spotify ✓"
                                android:textColor="#1ED760"
                                android:textSize="11sp"
                                android:textStyle="bold" />
                        </LinearLayout>
                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical">

                        <ImageView
                            android:id="@+id/imgAlbumArt"
                            android:layout_width="72dp"
                            android:layout_height="72dp"
                            android:src="@drawable/bg_now_playing_thumb"
                            android:scaleType="centerCrop"
                            android:layout_marginRight="14dp" />

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:orientation="vertical">

                            <TextView
                                android:id="@+id/detectedSongText"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:text="No music detected"
                                android:textColor="#FFFFFF"
                                android:textSize="16sp"
                                android:textStyle="bold"
                                android:singleLine="true"
                                android:ellipsize="end" />

                            <TextView
                                android:id="@+id/detectedArtistText"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:text="Play something in one of your selected apps."
                                android:textColor="#8E8E93"
                                android:textSize="12sp"
                                android:layout_marginTop="3dp"
                                android:singleLine="true"
                                android:ellipsize="end" />
                        </LinearLayout>
                    </LinearLayout>
                </LinearLayout>

                <!-- D. SOURCE APPS SECTION -->
                <LinearLayout
                    android:id="@+id/sourceAppsSection"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:background="@drawable/bg_m3_card"
                    android:padding="16dp"
                    android:layout_marginBottom="14dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical"
                        android:layout_marginBottom="12dp">

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:orientation="vertical">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Source Apps"
                                android:textColor="#FFFFFF"
                                android:textSize="16sp"
                                android:textStyle="bold" />

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Choose which apps NotiSpoti listens to"
                                android:textColor="#8E8E93"
                                android:textSize="11sp"
                                android:layout_marginTop="1dp" />
                        </LinearLayout>

                        <Button
                            android:id="@+id/btnManageApps"
                            android:layout_width="wrap_content"
                            android:layout_height="32dp"
                            android:text="Manage ›"
                            android:textColor="#FFFFFF"
                            android:textSize="11sp"
                            android:textStyle="bold"
                            android:background="@drawable/bg_m3_pill_secondary"
                            android:paddingLeft="14dp"
                            android:paddingRight="14dp" />
                    </LinearLayout>

                    <!-- Compact Quick-Toggle App Cards -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal">

                        <!-- YouTube Music -->
                        <LinearLayout
                            android:id="@+id/cardSourceYt"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:orientation="vertical"
                            android:gravity="center"
                            android:background="@drawable/bg_app_source_card"
                            android:padding="10dp"
                            android:layout_marginRight="6dp"
                            android:clickable="true"
                            android:focusable="true">

                            <RelativeLayout
                                android:layout_width="38dp"
                                android:layout_height="38dp">

                                <ImageView
                                    android:layout_width="36dp"
                                    android:layout_height="36dp"
                                    android:src="@drawable/ic_yt_music" />

                                <ImageView
                                    android:id="@+id/checkBadgeYt"
                                    android:layout_width="14dp"
                                    android:layout_height="14dp"
                                    android:src="@drawable/ic_check_circle"
                                    android:layout_alignParentRight="true"
                                    android:layout_alignParentTop="true" />
                            </RelativeLayout>

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="YouTube Music"
                                android:textColor="#E0E0E0"
                                android:textSize="10sp"
                                android:singleLine="true"
                                android:ellipsize="end"
                                android:layout_marginTop="4dp" />
                        </LinearLayout>

                        <!-- Obsidian -->
                        <LinearLayout
                            android:id="@+id/cardSourceObsidian"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:orientation="vertical"
                            android:gravity="center"
                            android:background="@drawable/bg_app_source_card"
                            android:padding="10dp"
                            android:layout_marginRight="6dp"
                            android:clickable="true"
                            android:focusable="true">

                            <RelativeLayout
                                android:layout_width="38dp"
                                android:layout_height="38dp">

                                <ImageView
                                    android:layout_width="36dp"
                                    android:layout_height="36dp"
                                    android:src="@drawable/ic_obsidian" />

                                <ImageView
                                    android:id="@+id/checkBadgeObsidian"
                                    android:layout_width="14dp"
                                    android:layout_height="14dp"
                                    android:src="@drawable/ic_check_circle"
                                    android:layout_alignParentRight="true"
                                    android:layout_alignParentTop="true" />
                            </RelativeLayout>

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Obsidian"
                                android:textColor="#E0E0E0"
                                android:textSize="10sp"
                                android:singleLine="true"
                                android:ellipsize="end"
                                android:layout_marginTop="4dp" />
                        </LinearLayout>

                        <!-- Music Player -->
                        <LinearLayout
                            android:id="@+id/cardSourceMusic"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:orientation="vertical"
                            android:gravity="center"
                            android:background="@drawable/bg_app_source_card"
                            android:padding="10dp"
                            android:layout_marginRight="6dp"
                            android:clickable="true"
                            android:focusable="true">

                            <RelativeLayout
                                android:layout_width="38dp"
                                android:layout_height="38dp">

                                <ImageView
                                    android:layout_width="36dp"
                                    android:layout_height="36dp"
                                    android:src="@drawable/ic_music_player" />

                                <ImageView
                                    android:id="@+id/checkBadgeMusic"
                                    android:layout_width="14dp"
                                    android:layout_height="14dp"
                                    android:src="@drawable/ic_check_circle"
                                    android:layout_alignParentRight="true"
                                    android:layout_alignParentTop="true" />
                            </RelativeLayout>

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Music"
                                android:textColor="#E0E0E0"
                                android:textSize="10sp"
                                android:singleLine="true"
                                android:ellipsize="end"
                                android:layout_marginTop="4dp" />
                        </LinearLayout>

                        <!-- Obsidian Music Alt -->
                        <LinearLayout
                            android:id="@+id/cardSourceCustom"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:orientation="vertical"
                            android:gravity="center"
                            android:background="@drawable/bg_app_source_card"
                            android:padding="10dp"
                            android:clickable="true"
                            android:focusable="true">

                            <RelativeLayout
                                android:layout_width="38dp"
                                android:layout_height="38dp">

                                <ImageView
                                    android:layout_width="36dp"
                                    android:layout_height="36dp"
                                    android:src="@drawable/ic_obsidian" />

                                <ImageView
                                    android:id="@+id/checkBadgeCustom"
                                    android:layout_width="14dp"
                                    android:layout_height="14dp"
                                    android:src="@drawable/ic_check_circle"
                                    android:layout_alignParentRight="true"
                                    android:layout_alignParentTop="true" />
                            </RelativeLayout>

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Obsidian Alt"
                                android:textColor="#E0E0E0"
                                android:textSize="10sp"
                                android:singleLine="true"
                                android:ellipsize="end"
                                android:layout_marginTop="4dp" />
                        </LinearLayout>
                    </LinearLayout>
                </LinearLayout>

                <!-- 3. CONNECTION STATUS -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:layout_marginBottom="16dp">

                    <!-- Notifications Card -->
                    <LinearLayout
                        android:id="@+id/tileNotificationAccess"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical"
                        android:background="@drawable/bg_status_tile"
                        android:padding="14dp"
                        android:layout_marginBottom="8dp"
                        android:clickable="true"
                        android:focusable="true">

                        <ImageView
                            android:layout_width="28dp"
                            android:layout_height="28dp"
                            android:src="@drawable/ic_bell"
                            android:layout_marginRight="12dp" />

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:orientation="vertical">

                            <LinearLayout
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:orientation="horizontal"
                                android:gravity="center_vertical">

                                <TextView
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text="Notifications"
                                    android:textColor="#FFFFFF"
                                    android:textSize="14sp"
                                    android:textStyle="bold" />

                                <TextView
                                    android:id="@+id/textNotificationStatus"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text="• Enabled"
                                    android:textColor="#1ED760"
                                    android:textSize="12sp"
                                    android:textStyle="bold"
                                    android:layout_marginLeft="8dp" />
                            </LinearLayout>

                            <TextView
                                android:id="@+id/textNotificationDesc"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="NotiSpoti can detect music from your selected apps"
                                android:textColor="#8E8E93"
                                android:textSize="11sp"
                                android:layout_marginTop="2dp" />
                        </LinearLayout>

                        <TextView
                            android:id="@+id/textNotificationAction"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="✓"
                            android:textColor="#1ED760"
                            android:textSize="18sp"
                            android:textStyle="bold"
                            android:layout_marginLeft="8dp" />
                    </LinearLayout>

                    <!-- Spotify Connection Card -->
                    <LinearLayout
                        android:id="@+id/tileSpotifyConnection"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical"
                        android:background="@drawable/bg_status_tile"
                        android:padding="14dp"
                        android:clickable="true"
                        android:focusable="true">

                        <ImageView
                            android:layout_width="28dp"
                            android:layout_height="28dp"
                            android:src="@drawable/ic_spotify_small"
                            android:layout_marginRight="12dp" />

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:orientation="vertical">

                            <LinearLayout
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:orientation="horizontal"
                                android:gravity="center_vertical">

                                <TextView
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text="Spotify"
                                    android:textColor="#FFFFFF"
                                    android:textSize="14sp"
                                    android:textStyle="bold" />

                                <TextView
                                    android:id="@+id/textSpotifyStatus"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text="• Connected"
                                    android:textColor="#1ED760"
                                    android:textSize="12sp"
                                    android:textStyle="bold"
                                    android:layout_marginLeft="8dp" />
                            </LinearLayout>

                            <TextView
                                android:id="@+id/textSpotifyDesc"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Ready to sync music"
                                android:textColor="#8E8E93"
                                android:textSize="11sp"
                                android:layout_marginTop="2dp" />
                        </LinearLayout>

                        <TextView
                            android:id="@+id/textSpotifyAction"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="✓"
                            android:textColor="#1ED760"
                            android:textSize="18sp"
                            android:textStyle="bold"
                            android:layout_marginLeft="8dp" />
                    </LinearLayout>
                </LinearLayout>

                <!-- 4. PRIMARY ACTION BUTTON -->
                <!-- Large bottom action/status button: -->
                <!-- Active: SYNC IS ACTIVE / Listening and syncing automatically -->
                <!-- Disabled: START SYNC / Start listening for music -->
                <!-- Uses circular sync arrows, NOT media play button! -->
                <LinearLayout
                    android:id="@+id/bannerMasterSync"
                    android:layout_width="match_parent"
                    android:layout_height="64dp"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:background="@drawable/bg_master_active_banner"
                    android:paddingLeft="20dp"
                    android:paddingRight="20dp"
                    android:layout_marginBottom="24dp"
                    android:clickable="true"
                    android:focusable="true">

                    <ImageView
                        android:id="@+id/imgMasterSyncIcon"
                        android:layout_width="28dp"
                        android:layout_height="28dp"
                        android:src="@drawable/ic_sync"
                        android:tint="#000000"
                        android:layout_marginRight="14dp" />

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            android:id="@+id/textMasterSyncTitle"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="SYNC IS ACTIVE"
                            android:textColor="#000000"
                            android:textSize="15sp"
                            android:textStyle="bold"
                            android:letterSpacing="0.05" />

                        <TextView
                            android:id="@+id/textMasterSyncSub"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Listening and syncing automatically"
                            android:textColor="#0A3816"
                            android:textSize="12sp" />
                    </LinearLayout>
                </LinearLayout>

            </LinearLayout>

            <!-- ================================================= -->
            <!-- SETTINGS & DEVELOPER TOOLS (Toggled by Settings)  -->
            <!-- ================================================= -->
            <LinearLayout
                android:id="@+id/viewSettingsTab"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:visibility="gone">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:layout_marginBottom="16dp">

                    <Button
                        android:id="@+id/btnBackFromSettings"
                        android:layout_width="wrap_content"
                        android:layout_height="36dp"
                        android:text="← Back to Home"
                        android:textColor="#FFFFFF"
                        android:textSize="12sp"
                        android:background="@drawable/bg_m3_pill_secondary"
                        android:paddingLeft="14dp"
                        android:paddingRight="14dp"
                        android:layout_marginRight="10dp" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Settings &amp; Developer Tools"
                        android:textColor="#FFFFFF"
                        android:textSize="15sp"
                        android:textStyle="bold" />
                </LinearLayout>

                <!-- Spotify Credentials Card -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:background="@drawable/bg_m3_card"
                    android:padding="16dp"
                    android:layout_marginBottom="12dp">

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Spotify Developer Credentials"
                        android:textColor="#FFFFFF"
                        android:textSize="14sp"
                        android:textStyle="bold" />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical"
                        android:layout_marginTop="10dp">

                        <EditText
                            android:id="@+id/inputClientId"
                            android:layout_width="0dp"
                            android:layout_height="44dp"
                            android:layout_weight="1"
                            android:background="@drawable/bg_m3_input"
                            android:paddingLeft="12dp"
                            android:paddingRight="12dp"
                            android:hint="Paste Spotify Client ID"
                            android:textColor="#FFFFFF"
                            android:textColorHint="#66726B"
                            android:textSize="12sp"
                            android:singleLine="true" />

                        <Button
                            android:id="@+id/btnConnectSdk"
                            android:layout_width="wrap_content"
                            android:layout_height="40dp"
                            android:text="Save &amp; Connect"
                            android:textColor="#FFFFFF"
                            android:textSize="11sp"
                            android:textStyle="bold"
                            android:background="@drawable/bg_m3_pill_button"
                            android:paddingLeft="14dp"
                            android:paddingRight="14dp"
                            android:layout_marginLeft="8dp" />
                    </LinearLayout>

                    <TextView
                        android:id="@+id/sdkHelpText"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Package: com.notispoti.app\nSHA1: C8:DD:03:A6:25:54:60:C1:5D:D1:B6:E3:F0:31:D1:2F:84:1B:59:AF"
                        android:textColor="#8E8E93"
                        android:textSize="10sp"
                        android:typeface="monospace"
                        android:layout_marginTop="10dp" />

                    <Button
                        android:id="@+id/btnCopySha1"
                        android:layout_width="wrap_content"
                        android:layout_height="34dp"
                        android:text="Copy SHA-1 Fingerprint"
                        android:textColor="#A0A0A0"
                        android:textSize="11sp"
                        android:background="@drawable/bg_m3_pill_secondary"
                        android:paddingLeft="14dp"
                        android:paddingRight="14dp"
                        android:layout_marginTop="8dp" />
                </LinearLayout>

                <!-- Manual Test Resolver Card -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:background="@drawable/bg_m3_card"
                    android:padding="16dp"
                    android:layout_marginBottom="12dp">

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Simulate Track Sync"
                        android:textColor="#FFFFFF"
                        android:textSize="14sp"
                        android:textStyle="bold" />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical"
                        android:layout_marginTop="10dp">

                        <EditText
                            android:id="@+id/inputTestSong"
                            android:layout_width="0dp"
                            android:layout_height="44dp"
                            android:layout_weight="1"
                            android:background="@drawable/bg_m3_input"
                            android:paddingLeft="12dp"
                            android:paddingRight="12dp"
                            android:hint="Song - Artist (e.g. Starboy)"
                            android:textColor="#FFFFFF"
                            android:textColorHint="#66726B"
                            android:textSize="12sp"
                            android:singleLine="true" />

                        <Button
                            android:id="@+id/btnTestResolve"
                            android:layout_width="wrap_content"
                            android:layout_height="40dp"
                            android:text="Test Sync"
                            android:textColor="#FFFFFF"
                            android:textSize="11sp"
                            android:background="@drawable/bg_m3_pill_secondary"
                            android:paddingLeft="14dp"
                            android:paddingRight="14dp"
                            android:layout_marginLeft="8dp" />
                    </LinearLayout>
                </LinearLayout>

                <!-- Real-Time Console Log Card -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:background="@drawable/bg_m3_card"
                    android:padding="16dp"
                    android:layout_marginBottom="16dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical"
                        android:layout_marginBottom="8dp">

                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="REAL-TIME IPC LOG CONSOLE"
                            android:textColor="#8E8E93"
                            android:textSize="10sp"
                            android:textStyle="bold" />

                        <Button
                            android:id="@+id/btnClearLogs"
                            android:layout_width="wrap_content"
                            android:layout_height="28dp"
                            android:text="Clear"
                            android:textColor="#8E8E93"
                            android:textSize="10sp"
                            android:background="@drawable/bg_m3_pill_secondary"
                            android:paddingLeft="10dp"
                            android:paddingRight="10dp" />
                    </LinearLayout>

                    <ScrollView
                        android:id="@+id/logScrollView"
                        android:layout_width="match_parent"
                        android:layout_height="180dp"
                        android:background="#070A08"
                        android:padding="10dp">

                        <TextView
                            android:id="@+id/logTextView"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:textColor="#00E676"
                            android:textSize="10sp"
                            android:typeface="monospace" />
                    </ScrollView>
                </LinearLayout>

            </LinearLayout>

        </LinearLayout>
    </ScrollView>

</RelativeLayout>
