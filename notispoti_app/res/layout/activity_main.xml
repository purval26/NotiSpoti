<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#121212"
    android:padding="14dp">

    <!-- Header -->
    <TextView
        android:id="@+id/titleHeader"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="NotiSpoti"
        android:textColor="#1DB954"
        android:textSize="22sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/subHeader"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="YT Music / Obsidian → Silent Spotify Sync"
        android:textColor="#B3B3B3"
        android:textSize="12sp"
        android:layout_marginBottom="12dp" />

    <!-- Master Sync Switch Card -->
    <LinearLayout
        android:id="@+id/masterSwitchLayout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:background="#1E1E1E"
        android:padding="12dp"
        android:layout_marginBottom="10dp">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/masterSwitchTitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Sync Engine: ACTIVE"
                android:textColor="#00E676"
                android:textSize="14sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/masterSwitchSubtitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Syncing tracks to Spotify in background"
                android:textColor="#888888"
                android:textSize="11sp" />
        </LinearLayout>

        <Switch
            android:id="@+id/masterSyncSwitch"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content" />
    </LinearLayout>

    <!-- Permission Banner / Button -->
    <LinearLayout
        android:id="@+id/permissionLayout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:background="#282828"
        android:padding="10dp"
        android:layout_marginBottom="10dp">

        <TextView
            android:id="@+id/permissionStatusText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Checking Notification Access..."
            android:textColor="#FFFFFF"
            android:textSize="13sp"
            android:textStyle="bold" />

        <Button
            android:id="@+id/btnGrantPermission"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Enable Notification Listener"
            android:textSize="12sp"
            android:visibility="gone"
            android:layout_marginTop="6dp" />
    </LinearLayout>

    <!-- Spotify App Remote SDK Configuration Card -->
    <LinearLayout
        android:id="@+id/sdkConfigLayout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:background="#202020"
        android:padding="10dp"
        android:layout_marginBottom="10dp">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="SPOTIFY APP REMOTE SDK (HEADLESS)"
            android:textColor="#1DB954"
            android:textSize="11sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/sdkStatusText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="SDK State: Not Connected"
            android:textColor="#FFCA28"
            android:textSize="12sp"
            android:layout_marginTop="2dp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginTop="6dp">

            <EditText
                android:id="@+id/inputClientId"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:hint="Paste Spotify Client ID"
                android:textColor="#FFFFFF"
                android:textColorHint="#777777"
                android:textSize="11sp"
                android:singleLine="true" />

            <Button
                android:id="@+id/btnConnectSdk"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Connect"
                android:textSize="11sp" />
        </LinearLayout>

        <TextView
            android:id="@+id/sdkHelpText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Pkg: com.notispoti.app\nSHA1: C8:DD:03:A6:25:54:60:C1:5D:D1:B6:E3:F0:31:D1:2F:84:1B:59:AF"
            android:textColor="#888888"
            android:textSize="9sp"
            android:typeface="monospace"
            android:layout_marginTop="4dp" />
    </LinearLayout>

    <!-- Source Apps Filter Card -->
    <LinearLayout
        android:id="@+id/sourceAppsLayout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:background="#202020"
        android:padding="10dp"
        android:layout_marginBottom="10dp">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="SOURCE APPS FILTER"
            android:textColor="#1DB954"
            android:textSize="11sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/selectedAppsStatusText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Loading selected apps..."
            android:textColor="#E0E0E0"
            android:textSize="12sp"
            android:layout_marginTop="2dp" />

        <Button
            android:id="@+id/btnManageApps"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Select Source Apps"
            android:textSize="11sp"
            android:layout_marginTop="6dp" />
    </LinearLayout>

    <!-- Live Detection Card -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:background="#181818"
        android:padding="10dp"
        android:layout_marginBottom="10dp">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="ACTIVE DETECTION"
            android:textColor="#1DB954"
            android:textSize="11sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/detectedSongText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Song: (Waiting for music...)"
            android:textColor="#FFFFFF"
            android:textSize="13sp"
            android:layout_marginTop="2dp" />

        <TextView
            android:id="@+id/spotifyMatchText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Spotify URI: -"
            android:textColor="#A7A7A7"
            android:textSize="12sp"
            android:typeface="monospace" />

        <TextView
            android:id="@+id/dispatchStatusText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Spotify Background State: Idle"
            android:textColor="#80D8FF"
            android:textSize="12sp"
            android:layout_marginTop="2dp" />
    </LinearLayout>

    <!-- Manual Test Bar -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_marginBottom="6dp">

        <EditText
            android:id="@+id/inputTestSong"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:hint="Song - Artist (e.g. Blinding Lights)"
            android:textColor="#FFFFFF"
            android:textColorHint="#666666"
            android:textSize="12sp"
            android:singleLine="true" />

        <Button
            android:id="@+id/btnTestResolve"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Test Sync"
            android:textSize="12sp" />
    </LinearLayout>

    <!-- Log Window -->
    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="REAL-TIME LOG"
        android:textColor="#888888"
        android:textSize="10sp"
        android:textStyle="bold"
        android:layout_marginBottom="2dp" />

    <ScrollView
        android:id="@+id/logScrollView"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:background="#0A0A0A"
        android:padding="6dp">

        <TextView
            android:id="@+id/logTextView"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textColor="#00E676"
            android:textSize="10sp"
            android:typeface="monospace" />
    </ScrollView>

</LinearLayout>
